# Theme (kept for backwards compat during migration)
# Set to: royal | midnight | forest
NEXT_PUBLIC_WEDDING_THEME=royal

# Database — Docker dev
DATABASE_URL=postgresql://ceremonia:ceremonia_dev@localhost:5432/ceremonia
# For Neon (prod): DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/ceremonia?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_f
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=ceremonia.app

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Create these products in your Stripe dashboard, then paste the price IDs here
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_STARTER_ONCE=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_AGENCY_MONTHLY=price_xxx

# Resend
RESEND_API_KEY=re_yyyy

# Upload
BLOB_READ_WRITE_TOKEN="BLOB_READ_WRITE_TOKEN"

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=phc_D
